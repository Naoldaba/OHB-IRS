# ---- Database (consumed by apps/api) ----
DATABASE_URL="postgresql://ohb:ohb_dev_password@localhost:5433/ohb_reports?schema=public"

# ---- API ----
API_PORT=4000
# Comma-separated origins allowed to send credentialed requests (the web app)
WEB_ORIGIN="http://localhost:3000"
# Secret used to sign the session cookie. Change in any non-local environment.
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"
# Session cookie lifetime in ms (default 8h)
SESSION_MAX_AGE_MS=28800000

# ---- File storage (profile pictures today; attachments later) ----
# Driver: "local" (default) stores files on disk and serves them statically.
# Swap for a cloud driver (s3/cloudinary) in production without code changes.
STORAGE_DRIVER=local
# Local driver only: directory for uploaded files (relative paths resolve from
# the API working dir) and the URL prefix they are served under.
LOCAL_STORAGE_DIR=uploads
ASSET_URL_PREFIX=uploads
# Public base URL the stored files are reachable at. Defaults to the API origin;
# set to your CDN / bucket base in production.
ASSET_PUBLIC_BASE_URL="http://localhost:4000"

# ---- Initial seeded Bureau Administrator ----
SEED_ADMIN_EMAIL="admin@ohb.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Bureau Administrator"

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
